<Project>
  <Import Project="..\repo.props" />

  <PropertyGroup>
    <PackagePublisher Condition="'$(PackagePublisher)' == ''">$(Publisher)</PackagePublisher>
    <PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)' == ''">$(PublisherDisplayName)</PackagePublisherDisplayName>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <PackageName Condition="'$(PackageName)' == ''">Contoso.Performance</PackageName>
    <PackageDisplayName Condition="'$(PackageDisplayName)' == ''">Performance Sample</PackageDisplayName>
    <PackageDescription Condition="'$(PackageDescription)' == ''">A sample Commerce Runtime extension project for performance testing.</PackageDescription>
  </PropertyGroup>
</Project>
